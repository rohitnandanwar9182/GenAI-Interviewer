{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (server.js)",
      "cwd": "${workspaceFolder}/Backend",
      "program": "${workspaceFolder}/Backend/server.js",
      "envFile": "${workspaceFolder}/Backend/.env",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
